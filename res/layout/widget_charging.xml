<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/variant_root" android:layout_width="match_parent" android:layout_height="160dp" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:background="@drawable/surface_system" android:clipToOutline="true">
<LinearLayout android:id="@+id/variant_header" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
<TextView android:id="@+id/variant_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="15sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<ImageView android:id="@+id/variant_settings" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/widget_settings" android:tint="@color/widget_initial_icon" android:contentDescription="@string/widget_settings"/>
</LinearLayout>
<LinearLayout android:id="@+id/charge_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
<TextView android:id="@+id/charge_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="42sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ViewFlipper android:id="@+id/charge_motion" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:inAnimation="@anim/widget_charge_pulse" android:animateFirstView="true" android:importantForAccessibility="noHideDescendants">
<ImageView android:id="@+id/charge_bolt" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bolt"/>
</ViewFlipper>
<TextView android:id="@+id/charge_state" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/charge_unknown" android:textSize="12sp" android:textColor="@color/widget_initial_secondary" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
<TextView android:id="@+id/charge_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/charge_no_time" android:textSize="15sp" android:textColor="@color/widget_initial_primary" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
</LinearLayout>
<ProgressBar android:id="@+id/charge_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="0" android:indeterminate="false"/>
<TextView android:id="@+id/variant_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/format_missing_data" android:textSize="10sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
</LinearLayout>
