<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/variant_root" android:layout_width="match_parent" android:layout_height="176dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/surface_system" android:clipToOutline="true">
<LinearLayout android:id="@+id/variant_header" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
<TextView android:id="@+id/variant_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="15sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<ImageView android:id="@+id/variant_settings" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/widget_settings" android:tint="@color/widget_initial_icon" android:contentDescription="@string/widget_settings"/>
</LinearLayout>
<LinearLayout android:id="@+id/electric_cell" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/electric_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/electric_range" android:textSize="10sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/range_electric" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<TextView android:id="@+id/variant_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_initial_secondary" android:importantForAccessibility="no"/>
<LinearLayout android:id="@+id/fuel_cell" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/fuel_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fuel_range" android:textSize="10sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/range_fuel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<TextView android:id="@+id/variant_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/format_missing_data" android:textSize="10sp" android:textColor="@color/widget_initial_primary" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
</LinearLayout>
