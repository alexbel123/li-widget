<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/shell" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/surface_system" android:clipToOutline="true">
 <LinearLayout android:id="@+id/filled" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:paddingBottom="8dp">
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false">
   <FrameLayout android:id="@+id/source_slot" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <FrameLayout android:id="@+id/compact_header_slot" android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="top|left" android:visibility="gone" android:importantForAccessibility="noHideDescendants"/>
   <ViewFlipper android:id="@+id/avatar_motion" android:layout_width="44dp" android:layout_height="44dp"
       android:layout_gravity="top|left" android:visibility="gone" android:clipChildren="false"
       android:inAnimation="@anim/widget_avatar_glide" android:animateFirstView="true"
       android:importantForAccessibility="noHideDescendants">
    <ImageView android:id="@+id/animated_avatar" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
   </ViewFlipper>
  </FrameLayout>
  <FrameLayout android:id="@+id/overview_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
  <FrameLayout android:id="@+id/overview_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
  <LinearLayout android:id="@+id/status_row" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:layout_width="match_parent" android:layout_height="24dp">
   <TextView android:id="@+id/status_dot" android:text="•" android:textSize="17sp" android:includeFontPadding="false" android:importantForAccessibility="no" android:layout_width="16dp" android:layout_height="wrap_content"/>
   <ViewFlipper android:id="@+id/charge_motion" android:layout_width="16dp" android:layout_height="16dp"
       android:inAnimation="@anim/widget_charge_pulse" android:animateFirstView="true"
       android:importantForAccessibility="noHideDescendants" android:visibility="gone">
    <ImageView android:id="@+id/charge_bolt" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bolt"/>
   </ViewFlipper>
   <ViewFlipper android:id="@+id/status_motion" android:layout_width="0dp" android:layout_weight="1"
       android:layout_height="wrap_content" android:inAnimation="@anim/widget_status_fade"
       android:animateFirstView="true">
    <TextView android:id="@+id/status_text" android:textSize="11sp" android:fontFamily="sans-serif" android:maxLines="2"
        android:ellipsize="end" android:includeFontPadding="false" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
   </ViewFlipper>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="110dp" android:orientation="vertical" android:padding="20dp" android:gravity="center">
  <ImageView android:id="@+id/brand" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_mark" android:tint="@color/widget_initial_icon" android:contentDescription="@string/app_name"/>
  <TextView android:id="@+id/empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/connect_title" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_initial_primary"/>
  <TextView android:id="@+id/empty_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/tap_configure" android:textSize="12sp" android:textColor="@color/widget_initial_secondary"/>
 </LinearLayout>
</FrameLayout>
